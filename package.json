{
  "name": "bid-intelligence",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @bid/shared build && pnpm --filter @bid/api build && pnpm --filter @bid/web build",
    "typecheck": "pnpm --filter @bid/shared typecheck && pnpm --filter @bid/api typecheck && pnpm --filter @bid/web typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:init": "pnpm --filter @bid/api db:init",
    "db:verify": "pnpm --filter @bid/api db:verify",
    "db:reset": "pnpm --filter @bid/api db:reset",
    "model:probe": "pnpm --filter @bid/api model:probe",
    "users:bootstrap": "pnpm --filter @bid/api users:bootstrap",
    "data:build": "pnpm --filter @bid/shared build && tsc -p scripts/phase-3-data/tsconfig.json && node -e \"const fs=require('node:fs');const link='scripts/phase-3-data/dist/node_modules';fs.rmSync(link,{force:true});fs.symlinkSync('../../../apps/api/node_modules',link,'dir')\"",
    "data:generate": "node scripts/phase-3-data/dist/scripts/phase-3-data/cli.js data:generate",
    "data:verify": "node scripts/phase-3-data/dist/scripts/phase-3-data/cli.js data:verify",
    "data:reconcile": "pnpm --filter @bid/api data:reconcile",
    "postgres:init": "pnpm --filter @bid/api postgres:init",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,graphql,gql,html,js,jsx,json,jsonc,md,mdx,scss,ts,tsx,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
