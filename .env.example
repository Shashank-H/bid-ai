# Compose binds host ports to loopback. API listens on port 3000 inside its container.
WEB_PORT=8080
API_PORT=3000

# Local-only database credentials: never use real AWS credentials here.
DYNAMODB_ENDPOINT=http://dynamodb:8000
# Selects identity, publisher-data and workflow tables together; preserve existing accounts.
TABLE_PREFIX=bid
AWS_REGION=local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# fixture: checked-in observations; database: persisted, ready-only publisher datasets.
# Switch to database only after explicit generation succeeds (exit 0 + seed-ready),
# using that same TABLE_PREFIX. The approved auction-item target is bid-publisher-data.
# Never reseed an occupied/incomplete prefix; see docs/requirements/phase 3/RUNBOOK.md.
REPOSITORY_MODE=fixture

# Public local-demo defaults; replace before sharing a deployment.
# No sessions or token hashes are stored in any database. Logout clears the browser cookie;
# a copied token remains valid until expiry. Rotating the secret invalidates every token.
AUTH_SIGNING_SECRET=bid-local-demo-signing-secret-not-for-production
APP_ORIGIN=http://localhost:8080
# Explicit users:bootstrap only. Existing accounts are not overwritten.
DEMO_PASSWORD_A=am4XhTMx-ZJSRCLzZezATi61
DEMO_PASSWORD_B=4iBX7EwJUCBK9rkJusc6_tgk

# Cookie configuration; Secure=true requires HTTPS.
SESSION_COOKIE_NAME=bid_session
SESSION_LIFETIME_SECONDS=28800
SESSION_COOKIE_SECURE=false

# PostgreSQL owns conversations + LangGraph checkpoints; not identity/auth sessions.
# Internal local-only default, no host port. Set a private password for nontrivial use.
POSTGRES_PASSWORD=local-development-only
# Optional URL override; otherwise uses the password above and postgres:5432/bid.
DATABASE_URL=

# Agent budgets independent of the compatibility probe.
AGENT_DEADLINE_MS=110000
AGENT_MAX_COMPLETION_TOKENS=4096

# Local Ollama defaults. Docker Desktop's host bridge reaches localhost:11434.
# Ollama needs no secret API key; 'ollama' is an SDK placeholder.
# A cold Qwen load can take about 70 seconds.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT_MS=110000
# Standard OpenAI-compatible request settings, applied independently of model name.
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0
# Optional bounded probe allowances for reasoning-capable models; defaults stay 64/128
# completion tokens and 32768 total received bytes. These are not product chat settings.
# LLM_PROBE_MAX_TOKENS=512
# LLM_PROBE_MAX_OUTPUT_BYTES=262144

# Required for chat only; foundation startup/health/login do not contact a model.
# Generic decision model: JEV's typed HTTP API, not an OpenAI base URL.
# Full evaluation endpoint; keep the API key private and server-side.
DECISION_MODEL_ENDPOINT=https://api.typesafe.ai/v1/systemone
DECISION_MODEL_API_KEY=
DECISION_MODEL_NAME=jev-latest
DECISION_MODEL_TIMEOUT_MS=5000
DECISION_MODEL_MIN_CONFIDENCE=0.5

# Optional server-only tracing to an EXISTING Langfuse project. No local stack is added.
# Set enabled=true only after privately configuring all three connection settings.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
# Export/flush/shutdown wait bound; application results do not depend on delivery.
LANGFUSE_TIMEOUT_MS=2000
